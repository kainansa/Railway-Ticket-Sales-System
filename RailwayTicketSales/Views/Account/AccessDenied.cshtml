@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-bold text-danger mb-2">Access Restricted</h3>
            <p class="text-muted mb-4">
                You do not have the required role permissions to access this page. Please sign in with an authorized account or return to the home page.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-railway">Log In with Another Account</a>
            </div>
        </div>
    </div>
</div>
