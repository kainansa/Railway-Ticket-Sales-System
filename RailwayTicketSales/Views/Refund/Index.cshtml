@model List<RailwayTicketSales.Models.Entities.Refund>
@{
    ViewData["Title"] = "Refund History & Status";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-arrow-counterclockwise me-2"></i>Refund History & Status</h3>
        <small class="text-muted">Overview of processed and pending ticket refund requests</small>
    </div>
    <a asp-controller="Ticket" asp-action="MyBookings" class="btn btn-outline-secondary">
        <i class="bi bi-ticket me-1"></i> My Tickets
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Refund Code</th>
                            <th>Ticket</th>
                            <th>Original Fare</th>
                            <th>Cancellation Fee</th>
                            <th>Refund Amount</th>
                            <th>Request Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-railway-blue">@r.RefundCode</td>
                                <td>
                                    <strong>@r.Ticket?.TicketCode</strong>
                                    <div class="small text-muted">@r.Ticket?.PassengerName</div>
                                </td>
                                <td>@r.TicketPrice.ToString("N0") VND</td>
                                <td class="text-danger">- @r.CancellationFee.ToString("N0") VND</td>
                                <td class="fw-bold text-success">@r.RefundAmount.ToString("N0") VND</td>
                                <td>@r.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @switch (r.RefundStatus)
                                    {
                                        case RefundStatus.Completed:
                                            <span class="badge bg-success">Completed</span>
                                            break;
                                        case RefundStatus.Pending:
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@r.RefundStatus</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No refund records found.
            </div>
        }
    </div>
</div>
