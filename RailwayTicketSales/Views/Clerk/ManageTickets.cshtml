@model List<RailwayTicketSales.Models.Entities.Ticket>
@{
    ViewData["Title"] = "Manage Tickets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-qr-code me-2"></i>Ticket Management & Operations</h3>
        <small class="text-muted">Search, change, cancel, or process refunds for tickets</small>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 p-3">
    <form asp-action="ManageTickets" method="get" class="row g-2 align-items-center">
        <div class="col-md-10">
            <input type="text" name="searchKeyword" value="@ViewBag.SearchKeyword" class="form-control" placeholder="Search by ticket code, passenger name, or ID card..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-railway w-100 fw-bold">Search</button>
        </div>
    </form>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Ticket Code</th>
                        <th>Passenger</th>
                        <th>Trip & Date</th>
                        <th>Coach & Seat</th>
                        <th>Fare</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Counter Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-railway-blue">@t.TicketCode</td>
                                <td>
                                    <strong>@t.PassengerName</strong>
                                    <div class="small text-muted">ID: @t.PassengerIdCard</div>
                                </td>
                                <td>
                                    <div><strong>@t.Schedule?.Train?.TrainNumber</strong> (@t.Schedule?.TripCode)</div>
                                    <div class="small text-muted">@t.Schedule?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        Coach @t.Seat?.Coach?.CoachNumber &bull; Seat @t.Seat?.SeatNumber
                                    </span>
                                </td>
                                <td class="fw-bold text-danger">@((t.TicketPrice + t.InsuranceFee).ToString("N0")) VND</td>
                                <td>
                                    @switch (t.TicketStatus)
                                    {
                                        case TicketStatus.ActivePaid:
                                            <span class="badge bg-success">Active / Paid</span>
                                            break;
                                        case TicketStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                        case TicketStatus.Refunded:
                                            <span class="badge bg-info text-dark">Refunded</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@t.TicketStatus</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-controller="Ticket" asp-action="Details" asp-route-id="@t.TicketId" class="btn btn-outline-primary btn-sm me-1" title="View E-ticket">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (t.TicketStatus == TicketStatus.ActivePaid)
                                    {
                                        <a asp-controller="Ticket" asp-action="Change" asp-route-id="@t.TicketId" class="btn btn-outline-warning btn-sm me-1" title="Change Ticket">
                                            <i class="bi bi-arrow-repeat"></i> Change
                                        </a>
                                        <a asp-controller="Ticket" asp-action="Cancel" asp-route-id="@t.TicketId" class="btn btn-outline-danger btn-sm" title="Cancel Ticket">
                                            <i class="bi bi-x-circle"></i> Cancel
                                        </a>
                                    }
                                    else if (t.TicketStatus == TicketStatus.Cancelled)
                                    {
                                        <a asp-controller="Refund" asp-action="RequestRefund" asp-route-ticketId="@t.TicketId" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-cash"></i> Refund
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No matching tickets found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
