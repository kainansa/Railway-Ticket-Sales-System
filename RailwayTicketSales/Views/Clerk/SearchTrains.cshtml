@model RailwayTicketSales.Models.ViewModels.TrainSearchViewModel
@{
    ViewData["Title"] = "Counter Train Search";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-railway-blue text-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0"><i class="bi bi-ticket-perforated me-2"></i>Counter Train Search & Booking</h4>
        <a asp-action="Index" class="btn btn-outline-light btn-sm">&larr; Back to Dashboard</a>
    </div>
    <div class="card-body p-4">
        <form asp-action="SearchTrains" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Departure Station</label>
                    <select class="form-select" name="departureStationId" required>
                        <option value="">-- Select Departure --</option>
                        @if (Model.Stations != null)
                        {
                            foreach (var s in Model.Stations)
                            {
                                <option value="@s.StationId" selected="@(s.StationId == Model.DepartureStationId)">@s.StationName (@s.StationCode)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Arrival Station</label>
                    <select class="form-select" name="arrivalStationId" required>
                        <option value="">-- Select Destination --</option>
                        @if (Model.Stations != null)
                        {
                            foreach (var s in Model.Stations)
                            {
                                <option value="@s.StationId" selected="@(s.StationId == Model.ArrivalStationId)">@s.StationName (@s.StationCode)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Travel Date</label>
                    <input type="date" class="form-control" name="travelDate" value="@Model.TravelDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-warning fw-bold w-100"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.HasSearched)
{
    if (Model.SearchResults != null && Model.SearchResults.Any())
    {
        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var res in Model.SearchResults)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-3">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <span class="badge bg-primary fs-6">Train @res.TrainNumber</span>
                                <span class="badge bg-secondary">@res.TrainType</span>
                                <div class="fw-bold mt-1">@res.TripCode</div>
                            </div>
                            <div class="col-md-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="fw-bold mb-0">@res.DepartureTime.ToString("HH:mm")</h5>
                                        <small class="text-muted">@res.DepartureStationName</small>
                                    </div>
                                    <div class="text-muted small">&rarr;</div>
                                    <div>
                                        <h5 class="fw-bold mb-0">@res.ArrivalTime.ToString("HH:mm")</h5>
                                        <small class="text-muted">@res.ArrivalStationName</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2 text-center">
                                <span class="badge bg-success-subtle text-success border border-success">
                                    @res.AvailableSeats / @res.TotalSeats Seats
                                </span>
                                <div class="fw-bold text-danger mt-1">@res.BasePrice.ToString("N0") VND</div>
                            </div>
                            <div class="col-md-3 text-end">
                                @if (res.AvailableSeats > 0)
                                {
                                    <a asp-action="CounterBooking" asp-route-scheduleId="@res.ScheduleId" class="btn btn-warning fw-bold">
                                        <i class="bi bi-cart-plus me-1"></i> Book at Counter
                                    </a>
                                }
                                else
                                {
                                    <button class="btn btn-secondary disabled" disabled>Sold Out</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            No matching trains found for the selected route and date.
        </div>
    }
}
