@model RailwayTicketSales.Models.ViewModels.CreateBookingRequest
@{
    ViewData["Title"] = "Counter Booking - Passenger Details";
    var schedule = ViewBag.Schedule as RailwayTicketSales.Models.Entities.Schedule;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-warning text-dark py-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-person-lines-fill me-2"></i>Enter Passenger Information (Counter Sale)</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="CreateCounterOrder" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ScheduleId" />

            <div class="row g-4">
                <div class="col-lg-8">
                    <!-- Customer Details -->
                    <div class="card border mb-4">
                        <div class="card-header bg-light fw-bold">Customer Contact Details</div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CustomerName" class="form-label fw-semibold">Customer Name *</label>
                                    <input asp-for="CustomerName" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerPhone" class="form-label fw-semibold">Phone Number *</label>
                                    <input asp-for="CustomerPhone" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerEmail" class="form-label fw-semibold">Email (optional)</label>
                                    <input asp-for="CustomerEmail" class="form-control" type="email" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CustomerIdCard" class="form-label fw-semibold">Citizen ID / Passport *</label>
                                    <input asp-for="CustomerIdCard" class="form-control" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Seats & Passengers -->
                    @for (int i = 0; i < Model.Passengers.Count; i++)
                    {
                        <div class="card border mb-3">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-dark">
                                    <i class="bi bi-ticket me-1"></i> Seat @Model.Passengers[i].SeatNumber (Coach @Model.Passengers[i].CoachNumber)
                                </span>
                                <span class="fw-bold text-danger">@Model.Passengers[i].Price.ToString("N0") VND</span>
                            </div>
                            <div class="card-body">
                                <input type="hidden" asp-for="Passengers[i].SeatId" />
                                <input type="hidden" asp-for="Passengers[i].SeatNumber" />
                                <input type="hidden" asp-for="Passengers[i].CoachNumber" />
                                <input type="hidden" asp-for="Passengers[i].Price" />

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Passenger Full Name *</label>
                                        <input asp-for="Passengers[i].PassengerName" class="form-control" placeholder="Passenger Name" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Citizen ID / Passport *</label>
                                        <input asp-for="Passengers[i].PassengerIdCard" class="form-control" placeholder="ID Number" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-lg-4">
                    <div class="card border shadow-sm sticky-top" style="top: 20px;">
                        <div class="card-header bg-warning text-dark py-3">
                            <h5 class="fw-bold mb-0">Counter Order Summary</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-2"><strong>Trip:</strong> @schedule?.TripCode</div>
                            <div class="mb-2"><strong>Date:</strong> @schedule?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                            <div class="mb-2"><strong>Seats:</strong> @Model.Passengers.Count</div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fs-5 fw-bold">Total:</span>
                                <span class="fs-4 fw-bold text-danger">
                                    @((Model.Passengers.Sum(p => p.Price) + (Model.Passengers.Count * 5000)).ToString("N0")) VND
                                </span>
                            </div>
                            <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold">
                                Create Counter Order &rarr;
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
