@model List<RailwayTicketSales.Models.Entities.BookingOrder>
@{
    ViewData["Title"] = "Ticket Clerk Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-person-workspace me-2"></i>Station Ticket Counter Portal</h3>
        <small class="text-muted">Ticket Clerk operations &bull; Counter Sales, Booking Search, Changes & Refunds</small>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SearchTrains" class="btn btn-warning fw-bold">
            <i class="bi bi-ticket-perforated me-1"></i> New Counter Booking
        </a>
    </div>
</div>

<!-- Quick Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <small class="text-muted fw-bold">TODAY'S ORDERS</small>
                <h3 class="fw-bold text-primary mb-0">@ViewBag.TodayBookings</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <small class="text-muted fw-bold">TICKETS ISSUED TODAY</small>
                <h3 class="fw-bold text-success mb-0">@ViewBag.TodayTicketsIssued</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <small class="text-muted fw-bold">TODAY'S COUNTER REVENUE</small>
                <h3 class="fw-bold text-danger mb-0">@(((decimal)ViewBag.TodayCounterRevenue).ToString("N0")) VND</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 border-start border-danger border-4">
            <div class="card-body">
                <small class="text-muted fw-bold">PENDING REFUNDS</small>
                <h3 class="fw-bold text-dark mb-0">@ViewBag.PendingRefunds</h3>
            </div>
        </div>
    </div>
</div>

<!-- Search & Quick Navigation -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 p-3">
            <h6 class="fw-bold mb-2"><i class="bi bi-search text-primary me-1"></i> Search Existing Bookings</h6>
            <form asp-action="ManageBookings" method="get" class="d-flex gap-2">
                <input type="text" name="searchKeyword" class="form-control" placeholder="Booking code, phone, or customer name..." />
                <button type="submit" class="btn btn-railway">Search</button>
            </form>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 p-3">
            <h6 class="fw-bold mb-2"><i class="bi bi-qr-code-scan text-primary me-1"></i> Search / Scan Tickets</h6>
            <form asp-action="ManageTickets" method="get" class="d-flex gap-2">
                <input type="text" name="searchKeyword" class="form-control" placeholder="Ticket code, ID card, passenger name..." />
                <button type="submit" class="btn btn-railway">Look up</button>
            </form>
        </div>
    </div>
</div>

<!-- Recent Orders Table -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Recent Counter & Online Bookings</h5>
        <a asp-action="ManageBookings" class="btn btn-sm btn-outline-primary">View All Bookings</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Booking Code</th>
                        <th>Customer</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Time</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var b in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-railway-blue">@b.BookingCode</td>
                                <td>
                                    <strong>@b.CustomerName</strong>
                                    <div class="small text-muted">@b.CustomerPhone</div>
                                </td>
                                <td>
                                    @if (b.IsCounterBooking)
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-shop"></i> Counter</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-globe"></i> Online</span>
                                    }
                                </td>
                                <td class="fw-bold text-danger">@b.TotalAmount.ToString("N0") VND</td>
                                <td>
                                    @if (b.OrderStatus == OrderStatus.Completed)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (b.OrderStatus == OrderStatus.AwaitingPayment)
                                    {
                                        <span class="badge bg-warning text-dark">Awaiting Payment</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@b.OrderStatus</span>
                                    }
                                </td>
                                <td>@b.CreatedDateTime.ToString("HH:mm dd/MM")</td>
                                <td class="text-end pe-3">
                                    @if (b.OrderStatus == OrderStatus.AwaitingPayment)
                                    {
                                        <a asp-action="ConfirmCounterPayment" asp-route-bookingOrderId="@b.BookingOrderId" class="btn btn-warning btn-sm fw-bold">
                                            Confirm Payment
                                        </a>
                                    }
                                    else if (b.OrderStatus == OrderStatus.Completed)
                                    {
                                        <a asp-action="PrintCounterTickets" asp-route-bookingOrderId="@b.BookingOrderId" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-printer"></i> Tickets
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
