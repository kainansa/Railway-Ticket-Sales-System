@model RailwayTicketSales.Models.ViewModels.ScheduleDetailsViewModel
@{
    ViewData["Title"] = "Select Coach & Seats";
    var schedule = Model.Schedule;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-railway-blue text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Select Coach & Seat</h4>
                <small>Train @schedule.Train?.TrainNumber (@schedule.TripCode) - @schedule.Route?.RouteName</small>
            </div>
            <a asp-controller="Train" asp-action="Index" class="btn btn-outline-light btn-sm">&larr; Back to Trains</a>
        </div>
    </div>

    <div class="card-body p-4">
        <!-- Trip Highlights -->
        <div class="row g-3 bg-light p-3 rounded mb-4 align-items-center">
            <div class="col-md-4">
                <strong>@schedule.Route?.DepartureStation?.StationName</strong> &rarr; <strong>@schedule.Route?.ArrivalStation?.StationName</strong>
            </div>
            <div class="col-md-4">
                <i class="bi bi-calendar3"></i> Departure: <strong>@schedule.DepartureTime.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
            <div class="col-md-4 text-md-end">
                Base Fare: <strong class="text-danger">@schedule.BasePrice.ToString("N0") VND</strong>
            </div>
        </div>

        <!-- Seat Legend -->
        <div class="d-flex flex-wrap align-items-center mb-4 p-2 border rounded bg-white">
            <span class="fw-bold me-3">Seat Legend:</span>
            <div class="seat-legend-item">
                <div class="seat-legend-box" style="background-color: #f8fafc; border-color: #cbd5e1;"></div>
                <span>Available</span>
            </div>
            <div class="seat-legend-item">
                <div class="seat-legend-box" style="background-color: #0f4c81; border-color: #0f4c81;"></div>
                <span>Selected</span>
            </div>
            <div class="seat-legend-item">
                <div class="seat-legend-box" style="background-color: #fef3c7; border-color: #f59e0b;"></div>
                <span>Temporarily Held (10m)</span>
            </div>
            <div class="seat-legend-item">
                <div class="seat-legend-box" style="background-color: #e2e8f0; border-color: #cbd5e1;"></div>
                <span>Booked / Reserved</span>
            </div>
        </div>

        <!-- Coach Navigation Tabs -->
        <ul class="nav nav-pills mb-4" id="coachTabs" role="tablist">
            @for (int cIndex = 0; cIndex < Model.Coaches.Count; cIndex++)
            {
                var coachVm = Model.Coaches[cIndex];
                <li class="nav-item" role="presentation">
                    <button class="nav-link @(cIndex == 0 ? "active" : "") fw-bold px-3 py-2 me-2 mb-2" 
                            id="tab-coach-@coachVm.Coach.CoachId" 
                            data-bs-toggle="pill" 
                            data-bs-target="#coach-@coachVm.Coach.CoachId" 
                            type="button" 
                            role="tab">
                        <i class="bi bi-train-front me-1"></i>Coach @coachVm.Coach.CoachNumber (@coachVm.Coach.CoachType)
                    </button>
                </li>
            }
        </ul>

        <!-- Coach Content Panels -->
        <div class="tab-content" id="coachTabsContent">
            @for (int cIndex = 0; cIndex < Model.Coaches.Count; cIndex++)
            {
                var coachVm = Model.Coaches[cIndex];
                <div class="tab-pane fade @(cIndex == 0 ? "show active" : "")" id="coach-@coachVm.Coach.CoachId" role="tabpanel">
                    <div class="seat-map-container mb-4">
                        <div class="text-center mb-3">
                            <span class="badge bg-secondary px-3 py-2 fs-6">
                                Coach @coachVm.Coach.CoachNumber &bull; @coachVm.Coach.CoachType &bull; Floor Count: @coachVm.Coach.FloorCount
                            </span>
                        </div>

                        <!-- Train Corridor / Layout -->
                        <div class="border rounded p-4 bg-light mx-auto" style="max-width: 650px;">
                            <div class="d-flex justify-content-between text-muted small mb-3 border-bottom pb-2">
                                <span><i class="bi bi-arrow-up"></i> Front of Carriage</span>
                                <span>Carriage Corridor</span>
                                <span>Rear of Carriage <i class="bi bi-arrow-down"></i></span>
                            </div>

                            <div class="seat-grid">
                                @foreach (var seat in coachVm.Seats)
                                {
                                    var isHeld = Model.UnavailableSeatIds.Contains(seat.SeatId) && !seat.IsAvailable;
                                    var seatClass = "seat-box";
                                    if (!seat.IsAvailable)
                                    {
                                        seatClass += " unavailable";
                                    }

                                    <div class="@seatClass" 
                                         data-seat-id="@seat.SeatId" 
                                         data-seat-num="@seat.SeatNumber" 
                                         data-coach-num="@coachVm.Coach.CoachNumber"
                                         data-price="@seat.Price"
                                         onclick="toggleSeat(this, @seat.SeatId, '@seat.SeatNumber', @seat.Price, @seat.IsAvailable.ToString().ToLower())">
                                        <div class="fw-bold">@seat.SeatNumber</div>
                                        <small class="d-block" style="font-size: 0.7rem;">@seat.SeatType</small>
                                        <small class="text-danger fw-semibold" style="font-size: 0.72rem;">@seat.Price.ToString("N0")</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Selected Seats Summary Card -->
        <div class="card bg-white border shadow-sm p-4 mt-4">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-1">Selected Seats: <span id="selectedCount" class="text-primary">0</span></h5>
                    <div id="selectedSeatsText" class="text-muted small">None selected yet. Click on available seats above to choose.</div>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <div class="fs-4 fw-bold text-danger mb-2" id="totalPrice">0 VND</div>
                    <form asp-action="PassengerInfo" method="get" id="proceedForm">
                        <input type="hidden" name="scheduleId" value="@schedule.ScheduleId" />
                        <input type="hidden" name="seatIds" id="seatIdsInput" />
                        <button type="submit" class="btn btn-railway btn-lg w-100 fw-bold" id="btnProceed" disabled>
                            Continue to Passenger Info <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedSeats = [];

        function toggleSeat(element, seatId, seatNumber, price, isAvailable) {
            if (!isAvailable) {
                alert('This seat is already booked or held by another passenger. Please pick another seat.');
                return;
            }

            const index = selectedSeats.findIndex(s => s.id === seatId);
            if (index >= 0) {
                // Deselect
                selectedSeats.splice(index, 1);
                element.classList.remove('selected');
            } else {
                // Select
                selectedSeats.push({ id: seatId, number: seatNumber, price: price });
                element.classList.add('selected');
            }

            updateSummary();
        }

        function updateSummary() {
            const countSpan = document.getElementById('selectedCount');
            const summaryText = document.getElementById('selectedSeatsText');
            const totalText = document.getElementById('totalPrice');
            const seatIdsInput = document.getElementById('seatIdsInput');
            const btnProceed = document.getElementById('btnProceed');

            countSpan.textContent = selectedSeats.length;

            if (selectedSeats.length === 0) {
                summaryText.textContent = 'None selected yet. Click on available seats above to choose.';
                totalText.textContent = '0 VND';
                seatIdsInput.value = '';
                btnProceed.disabled = true;
            } else {
                const numbers = selectedSeats.map(s => s.number).join(', ');
                const total = selectedSeats.reduce((acc, s) => acc + s.price, 0);
                summaryText.innerHTML = `<strong>Seats:</strong> ${numbers}`;
                totalText.textContent = total.toLocaleString('en-US') + ' VND';
                seatIdsInput.value = selectedSeats.map(s => s.id).join(',');
                btnProceed.disabled = false;
            }
        }
    </script>
}
