@model RailwayTicketSales.Models.ViewModels.ScheduleDetailsViewModel
@{
    ViewData["Title"] = "Train Schedule Details";
    var schedule = Model.Schedule;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-railway-blue text-white py-3">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-0">Train @schedule.Train?.TrainNumber - @schedule.TripCode</h4>
                <small>Route: @schedule.Route?.RouteName</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-light btn-sm">&larr; Back to Search</a>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted d-block">Departure Station</small>
                    <h5 class="fw-bold mb-0">@schedule.Route?.DepartureStation?.StationName</h5>
                    <div class="text-primary fw-semibold">@schedule.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted d-block">Arrival Station</small>
                    <h5 class="fw-bold mb-0">@schedule.Route?.ArrivalStation?.StationName</h5>
                    <div class="text-primary fw-semibold">@schedule.ArrivalTime.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded">
                    <small class="text-muted d-block">Base Price</small>
                    <h5 class="fw-bold text-danger mb-0">@schedule.BasePrice.ToString("N0") VND</h5>
                    <div class="small text-muted">Status: <span class="badge bg-success">@schedule.Status</span></div>
                </div>
            </div>
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Booking" asp-action="SelectSeat" asp-route-scheduleId="@schedule.ScheduleId" class="btn btn-railway btn-lg px-5 fw-bold">
                Proceed to Seat Selection <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</div>
