@model RailwayTicketSales.Models.ViewModels.TrainSearchViewModel
@{
    ViewData["Title"] = "Search Trains";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-railway-blue text-white py-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-search me-2"></i>Search Train Schedules</h4>
    </div>
    <div class="card-body p-4">
        <form asp-controller="Train" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Departure Station</label>
                    <select class="form-select" name="departureStationId" required>
                        <option value="">-- Choose Departure --</option>
                        @if (Model.Stations != null)
                        {
                            foreach (var s in Model.Stations)
                            {
                                <option value="@s.StationId" selected="@(s.StationId == Model.DepartureStationId)">@s.StationName (@s.StationCode)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Arrival Station</label>
                    <select class="form-select" name="arrivalStationId" required>
                        <option value="">-- Choose Destination --</option>
                        @if (Model.Stations != null)
                        {
                            foreach (var s in Model.Stations)
                            {
                                <option value="@s.StationId" selected="@(s.StationId == Model.ArrivalStationId)">@s.StationName (@s.StationCode)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Travel Date</label>
                    <input type="date" class="form-control" name="travelDate" value="@Model.TravelDate.ToString("yyyy-MM-dd")" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-railway w-100"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.HasSearched)
{
    if (Model.SearchResults != null && Model.SearchResults.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
                Found @Model.SearchResults.Count trains on @Model.TravelDate.ToString("dd/MM/yyyy")
            </h5>
            <span class="text-muted small">Prices include standard passenger carriage rates</span>
        </div>

        <div class="d-flex flex-column gap-3 mb-4">
            @foreach (var res in Model.SearchResults)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <!-- Train & Route Info -->
                            <div class="col-md-3 border-end">
                                <span class="badge bg-primary fs-6 mb-1">Train @res.TrainNumber</span>
                                <span class="badge bg-secondary mb-2">@res.TrainType</span>
                                <h6 class="fw-bold mb-1">@res.TripCode</h6>
                                <p class="text-muted small mb-0">Route: @res.RouteName</p>
                            </div>

                            <!-- Schedule Timing -->
                            <div class="col-md-5 px-md-4 border-end">
                                <div class="d-flex justify-content-between align-items-center text-center">
                                    <div>
                                        <h4 class="fw-bold text-railway-blue mb-0">@res.DepartureTime.ToString("HH:mm")</h4>
                                        <small class="text-muted">@res.DepartureStationName</small>
                                        <div class="small text-muted">@res.DepartureTime.ToString("dd/MM")</div>
                                    </div>

                                    <div class="px-2">
                                        <small class="text-muted d-block">@res.Duration.TotalHours.ToString("0.0") hrs</small>
                                        <div style="border-top: 2px dashed #94a3b8; width: 80px; margin: 4px auto;"></div>
                                        <i class="bi bi-arrow-right text-muted"></i>
                                    </div>

                                    <div>
                                        <h4 class="fw-bold text-railway-blue mb-0">@res.ArrivalTime.ToString("HH:mm")</h4>
                                        <small class="text-muted">@res.ArrivalStationName</small>
                                        <div class="small text-muted">@res.ArrivalTime.ToString("dd/MM")</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Availability & Pricing -->
                            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                <div class="mb-2">
                                    @if (res.AvailableSeats > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle"></i> @res.AvailableSeats seats available
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-x-circle"></i> Sold Out
                                        </span>
                                    }
                                </div>
                                <div>
                                    <small class="text-muted d-block">From</small>
                                    <span class="fs-4 fw-bold text-danger">@res.BasePrice.ToString("N0") VND</span>
                                </div>
                                <div class="mt-2">
                                    @if (res.AvailableSeats > 0)
                                    {
                                        <a asp-controller="Booking" asp-action="SelectSeat" asp-route-scheduleId="@res.ScheduleId" class="btn btn-railway fw-bold px-4">
                                            Select Seats <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary disabled" disabled>Sold Out</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Alternative flow A1: No matching train -->
        <div class="card border-0 shadow-sm text-center p-5 my-4">
            <div class="text-warning mb-3">
                <i class="bi bi-exclamation-circle" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold">No matching trains found</h4>
            <p class="text-muted">
                There are no train schedules operating on the selected route for date @Model.TravelDate.ToString("dd/MM/yyyy").
            </p>
            <div>
                <a asp-action="Index" class="btn btn-outline-primary">Try Another Date or Route</a>
            </div>
        </div>
    }
}
