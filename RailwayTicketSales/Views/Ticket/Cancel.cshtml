@model RailwayTicketSales.Models.ViewModels.CancellationCalculation
@{
    ViewData["Title"] = "Cancel Ticket";
    var ticket = ViewBag.Ticket as RailwayTicketSales.Models.Entities.Ticket;
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="fw-bold mb-0"><i class="bi bi-x-circle me-2"></i>Ticket Cancellation & Refund Calculation</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Important (BR-10):</strong> Once cancelled, this ticket cannot be used, restored, or changed again. The associated seat will be immediately released back to available inventory.
                </div>

                <!-- Ticket & Schedule Summary -->
                <div class="bg-light p-3 rounded mb-4 border">
                    <h6 class="fw-bold text-dark mb-2">Ticket Summary:</h6>
                    <div class="row g-2">
                        <div class="col-sm-6"><strong>Ticket:</strong> @ticket?.TicketCode</div>
                        <div class="col-sm-6"><strong>Passenger:</strong> @ticket?.PassengerName</div>
                        <div class="col-sm-6"><strong>Train:</strong> @ticket?.Schedule?.Train?.TrainNumber (@ticket?.Schedule?.TripCode)</div>
                        <div class="col-sm-6"><strong>Seat:</strong> @ticket?.Seat?.SeatNumber (Coach @ticket?.Seat?.Coach?.CoachNumber)</div>
                        <div class="col-sm-6"><strong>Departure Time:</strong> @ticket?.Schedule?.DepartureTime.ToString("dd/MM/yyyy HH:mm")</div>
                        <div class="col-sm-6"><strong>Hours Until Departure:</strong> @Model.HoursUntilDeparture.ToString("0.0") hrs</div>
                    </div>
                </div>

                <!-- Calculation Breakdown (BR-09) -->
                <div class="card border mb-4">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-receipt me-1"></i> Refund Calculation Breakdown (BR-09)
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Ticket Original Price:</span>
                            <strong>@Model.OriginalPrice.ToString("N0") VND</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Applicable Cancellation Fee (@Model.FeePercentage%):</span>
                            <strong>- @Model.CancellationFee.ToString("N0") VND</strong>
                        </div>
                        <div class="small text-muted mb-3">
                            <em>Policy: @Model.PolicyDescription</em>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-5 fw-bold">Refundable Amount:</span>
                            <span class="fs-4 fw-bold text-success">@Model.RefundableAmount.ToString("N0") VND</span>
                        </div>
                    </div>
                </div>

                <form asp-action="ConfirmCancel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketId" value="@Model.TicketId" />

                    <div class="d-flex justify-content-between">
                        <a asp-action="MyBookings" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Keep Ticket (Cancel Action)
                        </a>
                        <button type="submit" class="btn btn-danger fw-bold px-4" onclick="return confirm('Are you sure you want to cancel this ticket? The seat will be released immediately.')">
                            <i class="bi bi-trash3 me-1"></i> Confirm Cancellation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
