@model List<RailwayTicketSales.Models.Entities.RefundPolicy>
@{
    ViewData["Title"] = "Refund & Cancellation Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-railway-blue text-white py-3">
                <h3 class="fw-bold mb-0"><i class="bi bi-shield-check me-2"></i>Railway Ticket Refund & Cancellation Policy</h3>
            </div>
            <div class="card-body p-4">
                <p class="lead">
                    In accordance with railway operational standards (BR-07, BR-08, BR-09, and BR-10), passenger tickets may be cancelled or refunded prior to the train departure deadline.
                </p>

                <h5 class="fw-bold text-railway-blue mt-4 mb-3">Cancellation Fee & Refund Schedules</h5>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Departure Window</th>
                                <th>Cancellation Fee</th>
                                <th>Refundable Percentage</th>
                                <th>Description / Conditions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var p in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (p.HoursBeforeDeparture > 0)
                                            {
                                                <span class="badge bg-primary fs-6">&ge; @p.HoursBeforeDeparture Hours before Departure</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger fs-6">&lt; 4 Hours before Departure</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-danger">@p.FeePercentage%</td>
                                        <td class="fw-bold text-success">@(100 - p.FeePercentage)%</td>
                                        <td>@p.Description</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-info mt-4" role="alert">
                    <h6 class="fw-bold"><i class="bi bi-info-circle-fill me-1"></i> Key Rules:</h6>
                    <ul class="mb-0">
                        <li><strong>BR-07:</strong> A ticket can only be changed or cancelled before the configured deadline.</li>
                        <li><strong>BR-08:</strong> When changing a ticket, passengers pay the fare difference and administrative processing fees.</li>
                        <li><strong>BR-09:</strong> Refund amounts are calculated after deducting the applicable cancellation fee.</li>
                        <li><strong>BR-10:</strong> A cancelled ticket cannot be used, changed or cancelled again. Duplicate refund requests are prohibited.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
