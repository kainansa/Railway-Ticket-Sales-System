@using Microsoft.AspNetCore.Identity
@using RailwayTicketSales.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vietnam Railways Ticket Sales</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-railway-blue shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-train-front-fill fs-4 text-warning"></i>
                    <span>VIETNAM RAILWAYS</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Train" asp-action="Index"><i class="bi bi-search"></i> Search Trains</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="RefundPolicy"><i class="bi bi-shield-check"></i> Refund Policy</a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-warning fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear-fill"></i> Admin Portal
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Admin Dashboard</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Railway Data</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Trains"><i class="bi bi-train-front"></i> Manage Trains</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Stations"><i class="bi bi-building"></i> Manage Stations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Routes"><i class="bi bi-signpost-split"></i> Manage Routes</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Schedules"><i class="bi bi-calendar3"></i> Manage Schedules</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Ticket Config</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Coaches"><i class="bi bi-grid-3x3-gap"></i> Manage Coaches & Seats</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Fares"><i class="bi bi-tag"></i> Manage Fares</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header">Users & Reports</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people"></i> Manage Users</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="BookingReports"><i class="bi bi-file-earmark-bar-graph"></i> Booking Reports</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="RevenueReports"><i class="bi bi-cash-stack"></i> Revenue Reports</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemMonitor"><i class="bi bi-activity"></i> System Monitor</a></li>
                                    </ul>
                                </li>
                            }

                            if (User.IsInRole("TicketClerk") || User.IsInRole("Administrator"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-info fw-semibold" href="#" id="clerkDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-badge"></i> Ticket Clerk
                                    </a>
                                    <ul class="dropdown-menu shadow" aria-labelledby="clerkDropdown">
                                        <li><a class="dropdown-item" asp-controller="Clerk" asp-action="Index"><i class="bi bi-speedometer"></i> Clerk Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Clerk" asp-action="SearchTrains"><i class="bi bi-ticket-perforated"></i> Counter Booking</a></li>
                                        <li><a class="dropdown-item" asp-controller="Clerk" asp-action="ManageBookings"><i class="bi bi-journal-text"></i> Manage Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Clerk" asp-action="ManageTickets"><i class="bi bi-qr-code"></i> Manage Tickets</a></li>
                                        <li><a class="dropdown-item" asp-controller="Refund" asp-action="Index"><i class="bi bi-arrow-counterclockwise"></i> Process Refunds</a></li>
                                    </ul>
                                </li>
                            }

                            if (User.IsInRole("Passenger"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white fw-semibold" asp-controller="Ticket" asp-action="MyBookings">
                                        <i class="bi bi-ticket-detailed"></i> My Bookings
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Refund" asp-action="Index">
                                        <i class="bi bi-arrow-counterclockwise"></i> Refund History
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var currentUser = await UserManager.GetUserAsync(User);
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person"></i> My Profile</a></li>
                                    @if (User.IsInRole("Passenger"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Ticket" asp-action="MyBookings"><i class="bi bi-ticket-perforated"></i> My Tickets</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Log Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Log In</a>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-warning btn-sm text-dark fw-bold px-3" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 mt-auto">
        <div class="container">
            <div class="row gy-3">
                <div class="col-md-5">
                    <h6 class="text-white fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-train-front text-warning"></i> VIETNAM RAILWAY TICKET SYSTEM
                    </h6>
                    <p class="small text-secondary mb-1">
                        Academic Project – Software Architecture & Engineering (SWD).
                        Strictly compliant with URD and Analysis Modeling specifications.
                    </p>
                    <p class="small text-secondary mb-0">
                        &copy; 2026 Railway Ticket Sales System. All rights reserved.
                    </p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white fw-bold">Demo Accounts</h6>
                    <ul class="list-unstyled small text-secondary mb-0">
                        <li><strong>Admin:</strong> admin@railway.com (Admin@123)</li>
                        <li><strong>Clerk:</strong> clerk@railway.com (Clerk@123)</li>
                        <li><strong>Passenger:</strong> passenger@railway.com (Passenger@123)</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold">Quick Links</h6>
                    <ul class="list-unstyled small text-secondary mb-0">
                        <li><a href="/Home/RefundPolicy" class="text-secondary text-decoration-none">Refund & Cancellation Rules</a></li>
                        <li><a href="/Train/Index" class="text-secondary text-decoration-none">Search Trains</a></li>
                        <li><a href="/Account/Login" class="text-secondary text-decoration-none">Login Portal</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
