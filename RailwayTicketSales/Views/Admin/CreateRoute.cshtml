@model RailwayTicketSales.Models.Entities.Route
@{
    ViewData["Title"] = "Add Railway Route";
    var stations = ViewBag.Stations as List<RailwayTicketSales.Models.Entities.Station>;
}

<div class="row justify-content-center py-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-railway-blue text-white py-3">
                <h4 class="fw-bold mb-0">Add Railway Route</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateRoute" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="RouteCode" class="form-label fw-semibold">Route Code (e.g. HAN-DAN) *</label>
                        <input asp-for="RouteCode" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="RouteName" class="form-label fw-semibold">Route Name *</label>
                        <input asp-for="RouteName" class="form-control" placeholder="e.g. Ha Noi - Da Nang Express" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DepartureStationId" class="form-label fw-semibold">Departure Station *</label>
                            <select asp-for="DepartureStationId" class="form-select" required>
                                <option value="">-- Choose Origin --</option>
                                @if (stations != null)
                                {
                                    foreach (var s in stations)
                                    {
                                        <option value="@s.StationId">@s.StationName (@s.StationCode)</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ArrivalStationId" class="form-label fw-semibold">Arrival Station *</label>
                            <select asp-for="ArrivalStationId" class="form-select" required>
                                <option value="">-- Choose Destination --</option>
                                @if (stations != null)
                                {
                                    foreach (var s in stations)
                                    {
                                        <option value="@s.StationId">@s.StationName (@s.StationCode)</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ArrivalStationId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DistanceKm" class="form-label fw-semibold">Track Distance (km)</label>
                        <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" value="500" required />
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked />
                        <label class="form-check-label" asp-for="IsActive">Route is Active for Ticket Sales</label>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Routes" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-railway fw-bold px-4">Save Route</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
