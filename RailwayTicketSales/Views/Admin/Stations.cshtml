@model List<RailwayTicketSales.Models.Entities.Station>
@{
    ViewData["Title"] = "Manage Stations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-building me-2"></i>Railway Stations</h3>
        <small class="text-muted">Manage stations across the national railway network</small>
    </div>
    <a asp-action="CreateStation" class="btn btn-railway fw-bold">
        <i class="bi bi-plus-circle me-1"></i> Add Station
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Code</th>
                        <th>Station Name</th>
                        <th>City / Province</th>
                        <th>Address</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-3"><span class="badge bg-primary fs-6">@s.StationCode</span></td>
                            <td class="fw-bold text-railway-blue">@s.StationName</td>
                            <td>@s.City</td>
                            <td class="text-muted small">@s.Address</td>
                            <td class="text-end pe-3">
                                <a asp-action="EditStation" asp-route-id="@s.StationId" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                                <form asp-action="DeleteStation" asp-route-id="@s.StationId" method="post" class="d-inline" onsubmit="return confirm('Delete this station?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
