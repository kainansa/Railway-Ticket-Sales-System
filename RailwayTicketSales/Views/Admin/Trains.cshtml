@model List<RailwayTicketSales.Models.Entities.Train>
@{
    ViewData["Title"] = "Manage Trains";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-train-front me-2"></i>Train Fleet Management</h3>
        <small class="text-muted">Manage rolling stock, train configurations and status</small>
    </div>
    <a asp-action="CreateTrain" class="btn btn-railway fw-bold">
        <i class="bi bi-plus-circle me-1"></i> Add New Train
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Train Number</th>
                        <th>Type</th>
                        <th>Coaches</th>
                        <th>Total Capacity</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-railway-blue fs-5">Train @t.TrainNumber</td>
                            <td><span class="badge bg-primary">@t.TrainType</span></td>
                            <td>
                                <a asp-action="Coaches" asp-route-trainId="@t.TrainId" class="text-decoration-none">
                                    <strong>@t.Coaches.Count Coaches</strong> &bull; View &rarr;
                                </a>
                            </td>
                            <td>@t.TotalCapacity Seats</td>
                            <td>
                                <span class="badge @(t.Status == "Active" ? "bg-success" : "bg-warning")">@t.Status</span>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="EditTrain" asp-route-id="@t.TrainId" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                                <form asp-action="DeleteTrain" asp-route-id="@t.TrainId" method="post" class="d-inline" onsubmit="return confirm('Delete this train?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
