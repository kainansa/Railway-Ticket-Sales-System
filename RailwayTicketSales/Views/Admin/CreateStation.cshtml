@model RailwayTicketSales.Models.Entities.Station
@{
    ViewData["Title"] = "Add Railway Station";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-railway-blue text-white py-3">
                <h4 class="fw-bold mb-0">Add Railway Station</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateStation" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="StationCode" class="form-label fw-semibold">Station Code (3 letters, e.g. HAN, SGO) *</label>
                        <input asp-for="StationCode" class="form-control" required maxlength="10" />
                        <span asp-validation-for="StationCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StationName" class="form-label fw-semibold">Station Name *</label>
                        <input asp-for="StationName" class="form-control" placeholder="e.g. Ha Noi Station" required />
                        <span asp-validation-for="StationName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="City" class="form-label fw-semibold">City / Province *</label>
                        <input asp-for="City" class="form-control" placeholder="e.g. Ha Noi" required />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold">Full Address</label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. 120 Le Duan, Dong Da" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Stations" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-railway fw-bold px-4">Save Station</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
