@model RailwayTicketSales.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Add Railway Staff";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-railway-blue text-white py-3">
                <h4 class="fw-bold mb-0">Create Railway Staff Account</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateStaff" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Staff Role *</label>
                        <select name="staffRole" class="form-select" required>
                            <option value="TicketClerk" selected>Ticket Clerk (Station Counter Sales & Refunds)</option>
                            <option value="Administrator">Administrator (Full System Control)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Staff Full Name *</label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">Corporate Email *</label>
                            <input asp-for="Email" class="form-control" type="email" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IdCard" class="form-label fw-semibold">Employee Citizen ID / Staff ID</label>
                        <input asp-for="IdCard" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">Station / Department Office</label>
                        <input asp-for="Address" class="form-control" placeholder="e.g. Hanoi Station Counter 02" />
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Temporary Password *</label>
                            <input asp-for="Password" class="form-control" type="password" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Users" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-railway fw-bold px-4">Create Staff Member</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
