@model List<RailwayTicketSales.Models.Entities.Schedule>
@{
    ViewData["Title"] = "Manage Schedules";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-railway-blue mb-0"><i class="bi bi-calendar3 me-2"></i>Train Schedules / Trips</h3>
        <small class="text-muted">Manage scheduled train runs, operational states and timetables</small>
    </div>
    <a asp-action="CreateSchedule" class="btn btn-railway fw-bold">
        <i class="bi bi-plus-circle me-1"></i> Schedule New Trip
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Trip Code</th>
                        <th>Train</th>
                        <th>Route</th>
                        <th>Departure</th>
                        <th>Arrival</th>
                        <th>Base Fare</th>
                        <th>Operational State</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-railway-blue">@s.TripCode</td>
                            <td><span class="badge bg-primary">Train @s.Train?.TrainNumber</span></td>
                            <td>
                                <strong>@s.Route?.DepartureStation?.StationCode &rarr; @s.Route?.ArrivalStation?.StationCode</strong>
                                <div class="small text-muted">@s.Route?.RouteName</div>
                            </td>
                            <td>
                                <strong>@s.DepartureTime.ToString("HH:mm")</strong>
                                <div class="small text-muted">@s.DepartureTime.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <strong>@s.ArrivalTime.ToString("HH:mm")</strong>
                                <div class="small text-muted">@s.ArrivalTime.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="fw-bold text-danger">@s.BasePrice.ToString("N0") VND</td>
                            <td>
                                <form asp-action="ChangeScheduleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="scheduleId" value="@s.ScheduleId" />
                                    <select name="status" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                        <option value="Scheduled" selected="@(s.Status == TripStatus.Scheduled)">Scheduled</option>
                                        <option value="BookingOpen" selected="@(s.Status == TripStatus.BookingOpen)">BookingOpen</option>
                                        <option value="SoldOut" selected="@(s.Status == TripStatus.SoldOut)">SoldOut</option>
                                        <option value="BookingClosed" selected="@(s.Status == TripStatus.BookingClosed)">BookingClosed</option>
                                        <option value="InTransit" selected="@(s.Status == TripStatus.InTransit)">InTransit</option>
                                        <option value="Completed" selected="@(s.Status == TripStatus.Completed)">Completed</option>
                                    </select>
                                </form>
                            </td>
                            <td class="text-end pe-3">
                                <a asp-action="EditSchedule" asp-route-id="@s.ScheduleId" class="btn btn-outline-primary btn-sm me-1">Edit</a>
                                <a asp-controller="Booking" asp-action="SelectSeat" asp-route-scheduleId="@s.ScheduleId" class="btn btn-outline-secondary btn-sm" target="_blank" title="View Seats">
                                    <i class="bi bi-grid-3x3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
